{
  "name": "@zcode/epoch-timeline",
  "version": "0.1.0",
  "private": true,
  "description": "Timeline and construction state: the projection authority for construction phases and portable timeline positions over world revisions.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "test": "tsc -b && node --test \"dist/test/*.test.js\""
  },
  "dependencies": {
    "@zcode/epoch-world-model": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@zcode/epoch-construction-fixture": "workspace:*",
    "typescript": "^5.6.0"
  }
}
