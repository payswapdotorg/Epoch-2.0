{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "lib": ["es2025", "dom", "dom.iterable"],
    "jsx": "react-jsx",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@zcode/epoch-world-model": ["../epoch-world-model/src/index.ts"],
      "@zcode/epoch-reconstruction-contract": ["../epoch-reconstruction-contract/src/index.ts"],
      "@zcode/epoch-world-presentation": ["../epoch-world-presentation/src/index.ts"],
      "@zcode/epoch-renderer-contract": ["../epoch-renderer-contract/src/index.ts"],
      "@zcode/epoch-solution-contract": ["../epoch-solution-contract/src/index.ts"],
      "@zcode/epoch-solution-surface": ["../epoch-solution-surface/src/index.ts"],
      "@zcode/epoch-construction-fixture": ["../epoch-construction-fixture/src/index.ts"],
      "@zcode/epoch-renderer-babylon": ["../epoch-renderer-babylon/src/index.ts"],
      "@zcode/epoch-solution-runtime": ["../epoch-solution-runtime/src/index.ts"],
      "@zcode/epoch-world-interaction": ["../epoch-world-interaction/src/index.ts"]
    }
  },
  "include": ["src"],
  "references": [
    { "path": "../ui" },
    { "path": "../client" },
    { "path": "../epoch-world-model" },
    { "path": "../epoch-reconstruction-contract" },
    { "path": "../epoch-world-presentation" },
    { "path": "../epoch-renderer-contract" },
    { "path": "../epoch-solution-contract" },
    { "path": "../epoch-solution-surface" },
    { "path": "../epoch-construction-fixture" },
    { "path": "../epoch-renderer-babylon" },
    { "path": "../epoch-solution-runtime" },
    { "path": "../epoch-world-interaction" }
  ]
}
